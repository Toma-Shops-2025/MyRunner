# Copy to Vercel Project → Settings → Environment Variables (Production).
# You do NOT need Netlify to recover these — use the "Where to find" notes in docs/VERCEL_SETUP.md

# --- Supabase (required) ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- App URL (required in production) ---
PUBLIC_APP_URL=https://myrunner.shop

# --- Stripe (required for payments / Connect) ---
STRIPE_ENV=live
VITE_PAYMENTS_CLIENT_TOKEN=
STRIPE_LIVE_API_KEY=
STRIPE_SANDBOX_API_KEY=
PAYMENTS_LIVE_WEBHOOK_SECRET=
PAYMENTS_SANDBOX_WEBHOOK_SECRET=

# --- Mapbox (maps in app) ---
MAPBOX_PUBLIC_TOKEN=

# --- Optional: Checkr, Gemini, cron ---
CHECKR_API_KEY=
CHECKR_PACKAGE_SLUG=
CHECKR_WEBHOOK_SECRET=
GEMINI_API_KEY=
DISPATCH_CRON_SECRET=

# --- Build preset (Vercel default; only set netlify if you return to Netlify) ---
# NITRO_PRESET=vercel